# Copy to .env locally. Never commit real secrets.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
APP_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
APP_USER_ID=owner
APP_OWNER_EMAIL=
APP_OWNER_PHONE_E164=+10000000000

# Base64-encoded 32-byte key: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=phone_google
MYSQL_USER=phone_google
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional Gemini customer-reply generation. Keep the key only in this ignored .env or a host secret store.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BUSINESS_CONTEXT=

# Smart Zero-Cost Router (optional) — all keys stay in .env / host secrets only.
# AgentRouter is OpenAI-compatible: https://agentrouter.org/v1/chat/completions
# Both spellings are accepted because the GitHub Secret is stored as AGENETROUTERAPI_KEY.
AGENTROUTER_API_KEY=
AGENETROUTERAPI_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=glm-4.5-air
# DeepSeek is reserved for deep/coding tasks only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AI_ROUTER_FAST_TIMEOUT_MS=12000
AI_ROUTER_DEEP_TIMEOUT_MS=45000
AI_ROUTER_COOLDOWN_MS=60000

# Celia MCP server (JSON-RPC 2.0 over HTTP Bearer + stdio).
# Generate a 32-byte hex token: `openssl rand -hex 32`
CELIA_MCP_API_TOKEN=replace-with-hex-token-from-openssl-rand-hex-32
CELIA_MCP_HOST=0.0.0.0
CELIA_MCP_PORT=3010
# auto | gemini | ollama | router (router = force the Smart Zero-Cost Router)
CELIA_AI_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Phase 2/3 secrets — used by the Actions secret audit; consumed by code in later phases.
ELEVENLABS_API_KEY=
CELIA_VOICE_ID=
FIGMA_ACCESS_TOKEN=

# Celia voice engine (Phase 2) — zero-cost defaults protect the free quota.
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
VOICE_MAX_CHARS_PER_MESSAGE=250
VOICE_DAILY_CHAR_BUDGET=600
VOICE_CACHE_MAX_ENTRIES=200
VOICE_COOLDOWN_MS=60000
VOICE_TIMEOUT_MS=15000

# Celia Figma bridge (Phase 3) — read-only free-tier API calls.
FIGMA_BASE_URL=https://api.figma.com/v1
FIGMA_TIMEOUT_MS=12000
FIGMA_MAX_NODES=40
FIGMA_MAX_DEPTH=4

# Optional free deployment (GitHub Actions secrets only, never app env).
# RENDER_DEPLOY_HOOK_URL / KOYEB_API_TOKEN / KOYEB_SERVICE_ID
# They belong in Repository Secrets, not in this file.

# WhatsApp Cloud API (Meta). Keep auto-replies disabled until consent and policies are configured.
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verification-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_AUTO_REPLY_ENABLED=false
