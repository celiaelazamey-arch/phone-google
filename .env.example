# Copy to .env locally. Never commit real secrets.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
APP_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
APP_USER_ID=owner
APP_OWNER_EMAIL=
APP_OWNER_PHONE_E164=+10000000000

# Base64-encoded 32-byte key: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=phone_google
MYSQL_USER=phone_google
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional Gemini customer-reply generation. Keep the key only in this ignored .env or a host secret store.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BUSINESS_CONTEXT=

# WhatsApp Cloud API (Meta). Keep auto-replies disabled until consent and policies are configured.
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verification-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_AUTO_REPLY_ENABLED=false
