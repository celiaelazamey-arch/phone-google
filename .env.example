# Copy to .env locally. Never commit real secrets.
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
APP_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
APP_USER_ID=owner
APP_OWNER_EMAIL=
APP_OWNER_PHONE_E164=+10000000000
# Owner time zone for WhatsApp replies ("جدولي", email dates). IANA name; default Africa/Cairo
CELIA_TIMEZONE=Africa/Cairo
# Origin of the Cloudflare edge Worker the /cron dashboard calls from the browser (CSP connect-src). https only; default is the live Worker.
# CELIA_EDGE_ORIGIN=https://celia-phone-google.celiaelazamey.workers.dev

# Base64-encoded 32-byte key: `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=phone_google
MYSQL_USER=phone_google
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# After filling the Google values, run `npm run google:doctor` for an offline preflight
# (redirect_uri_mismatch, missing credentials, disabled owner check, localhost links).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional Gemini customer-reply generation. Keep the key only in this ignored .env or a host secret store.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BUSINESS_CONTEXT=

# Additional governed AI providers (wired from Repository Secrets / host secret store; never committed).
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_MODEL=google/gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Supports exact GitHub Repository Secret name AGENETROUTERAPI_KEY and canonical alias AGENTROUTER_API_KEY.
AGENETROUTERAPI_KEY=
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=deepseek-chat
# By default auto calls at most one cloud provider before local fallback; set true only to allow cross-vendor cloud failover.
CELIA_AI_ALLOW_CLOUD_FAILOVER=false

# Celia Voice synthesis (ElevenLabs TTS + Voice ID).
ELEVENLABS_API_KEY=
CELIA_VOICE_ID=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL=eleven_multilingual_v2

# Figma read-only design inspection.
FIGMA_ACCESS_TOKEN=
FIGMA_BASE_URL=https://api.figma.com/v1

# Codata read-only workspace integration (supports exact secret name YOUR_CODATA_API_KEY and CODATA_API_KEY).
YOUR_CODATA_API_KEY=
CODATA_API_KEY=
CODATA_WORKSPACE_ID=6ae05ac477ceef820d0c5831
CODATA_BASE_URL=

# Celia MCP server (JSON-RPC 2.0 over HTTP Bearer + stdio).
# Generate a 32-byte hex token: `openssl rand -hex 32`
CELIA_MCP_API_TOKEN=replace-with-hex-token-from-openssl-rand-hex-32
CELIA_MCP_HOST=0.0.0.0
CELIA_MCP_PORT=3010
# Optional extended MCP tools (celia_voice_speak, figma_file_inspect, codata_status, celia_secrets_status).
# Default false preserves the exact 12-tool legacy MCP contract.
CELIA_EXTENDED_MCP_TOOLS=false
# Set to true to skip MySQL entirely and run on the in-memory store (demo/preview only — data is not persisted).
CELIA_MCP_DISABLE_MYSQL=false
# Optional marketing-first mode: / serves the landing page and /studio serves the agent workspace.
CELIA_LANDING_ROOT=false
CELIA_AI_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# WhatsApp Cloud API (Meta). Keep auto-replies disabled until consent and policies are configured.
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verification-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_AUTO_REPLY_ENABLED=false
# WP-2.2 (DEC-058): last-N window for the same number + top-3 T1/T2 knowledge items in customer replies.
# off is the only tested default; on needs WHATSAPP_AUTO_REPLY_ENABLED=true and, for knowledge, CELIA_KB=sqlite.
CELIA_WA_CONTEXT=off

# Resilience: each integration has its own timeout, breaker and in-flight limit.
CELIA_SERVICE_TIMEOUT_MS=8000
CELIA_CIRCUIT_FAILURE_THRESHOLD=3
CELIA_CIRCUIT_COOLDOWN_MS=30000
CELIA_SERVICE_CONCURRENCY=6
# Emergency kill switches. true disables that integration without stopping the core.
CELIA_DISABLE_GOOGLE=false
CELIA_DISABLE_WHATSAPP=false
CELIA_DISABLE_GEMINI=false
CELIA_DISABLE_AI_GATEWAY=false
CELIA_DISABLE_DEEPSEEK=false
CELIA_DISABLE_AGENTROUTER=false
CELIA_DISABLE_ELEVENLABS=false
CELIA_DISABLE_FIGMA=false
CELIA_DISABLE_CODATA=false
CELIA_DISABLE_OLLAMA=false
# Allow a non-loopback Ollama endpoint only on a trusted network.
OLLAMA_ALLOW_REMOTE=false
# Optional 40-character commit identity, supplied by the release image build.
CELIA_BUILD_SHA=

# Optional full single-port runtime. Defaults preserve the old MCP-only entry point.
# Requires durable MySQL, TOKEN_ENCRYPTION_KEY, and HTTPS APP_BASE_URL (or Render's RENDER_EXTERNAL_URL).
CELIA_ENABLE_INTEGRATIONS=false
# Explicit first installation of an EMPTY dedicated database only; never a migration/repair.
CELIA_DB_INITIALIZE=false
# Optional deployment-centre home page; /studio and existing routes remain available.
CELIA_DEPLOYMENT_ROOT=false
# Optional custom CA, e.g. `openssl base64 -A -in ca.pem`. Never disable certificate verification.
# Production always uses TLS. Development may opt in with MYSQL_SSL=true.
MYSQL_SSL=
MYSQL_SSL_CA_BASE64=


# ── Agent runtime (optional, off by default) ─────────────────────────────────────
# CELIA_AGENT_RUNTIME=mysql      # production: durable MySQL; tables created by `npm run migrate -- --apply`
# CELIA_AGENT_RUNTIME=sqlite     # local/demo: durable file store, refused when NODE_ENV=production
# CELIA_AGENT_SQLITE_PATH=.data/agent.sqlite3
# CELIA_AGENT_CONNECTORS=none    # opt-in only; google_read enables Gmail/Drive/Calendar/Contacts reads
#                                # google_read adds no scopes and no outbox writes; calendar/drive keep their
#                                # separate approval-gated effect meaning. Requires the existing encrypted grant.
# CELIA_AGENT_MAX_STEPS=12
# CELIA_AGENT_MAX_COST_MICROS=100000
# CELIA_AGENT_MAX_DURATION_MS=120000
# CELIA_AGENT_RESUME_ON_BOOT=true # explicit: a (re)started process settles abandoned dispatches as `unknown`
#                                 # and resumes parked runs; default false = a human triggers recovery
# WP-3.1 / DEC-059 — planner choice. demo = deterministic (default). provider = the model plans inside the same
# closed 2–4 read-tool set, and any provider failure becomes a visible deterministic fallback step.
# GEMINI_API_KEY is required for provider mode; missing key fails closed (planner_provider_not_configured).
# CELIA_AGENT_PLANNER=demo
# CELIA_AGENT_PLANNER_TOOLS=celia.thread_context,product.catalog_audit   # optional narrowing; reads only
# CELIA_AGENT_PLANNER_TIMEOUT_MS=20000

# ── Knowledge network (optional, off by default; never a silent memory fallback) ─
# CELIA_KB=sqlite                # enables /api/kb and the read-only kb.* agent tools
# CELIA_KB_PATH=.data/knowledge.sqlite3
# CELIA_KB_PERSISTENT=true       # set only when the path is on a mounted disk in production
# CELIA_KB_ALLOW_REMOTE_IMPORT=false  # keep false: import with `npm run kb -- import --apply`
