FROM node:22-alpine
ENV NODE_ENV=production \
    CELIA_MCP_HOST=0.0.0.0 \
    CELIA_MCP_PORT=3010 \
    CELIA_MCP_DISABLE_MYSQL=true
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY src ./src
COPY public ./public
COPY sql ./sql
EXPOSE 3010
USER node
CMD ["node", "src/celia-mcp.js"]
