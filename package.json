{
  "name": "phone-google-assistant",
  "version": "0.2.1",
  "private": false,
  "description": "Celia assistant with isolated integrations, health-gated releases and safe rollback",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/init-db.js",
    "migrate": "node scripts/migrate.mjs",
    "kb": "node scripts/kb.mjs",
    "kb:manifest": "node scripts/kb-manifest.mjs",
    "kb:seed": "node scripts/kb-seed.mjs",
    "celia:mcp": "node src/celia-mcp.js",
    "celia:mcp:stdio": "node src/celia-mcp.js --stdio",
    "celia:mcp:verify": "node src/celia-mcp.js --self-test",
    "test": "node --test",
    "test:sandbox": "CELIA_SANDBOX_INTEGRATION=1 node --test test/agent-sandbox.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-include=scripts/** --test-coverage-include=workers/** --test-coverage-lines=89 --test-coverage-branches=71 --test-coverage-functions=82",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/test-reporter-gha.mjs --test-reporter-destination=stdout",
    "test:coverage:ci": "npm run test:coverage -- --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/test-reporter-gha.mjs --test-reporter-destination=stdout",
    "check": "node scripts/check.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/build-pages.mjs && node scripts/serve-pages.mjs",
    "deploy:release": "node scripts/deploy-release.mjs",
    "deploy:render": "node scripts/deploy-render.mjs",
    "reality": "node scripts/service-reality.mjs",
    "triage": "node scripts/issue-triage.mjs",
    "triage:verify": "node scripts/issue-triage-verify.mjs",
    "ci:notify": "node scripts/ci-failure-notify.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:bundle": "node scripts/release.mjs bundle",
    "release:verify": "node scripts/release.mjs verify",
    "test:resilience": "node --test test/resilience.test.js test/operations.test.js test/deployment.test.js",
    "test:browser": "playwright test",
    "test:copilot-bridge": "node --test test/copilot-mcp-bridge.test.js",
    "copilot:diagram": "node scripts/render-copilot-architecture.mjs",
    "copilot:diagram:check": "node scripts/render-copilot-architecture.mjs --check",
    "computer:permissions": "node scripts/render-computer-permissions.mjs",
    "computer:permissions:check": "node scripts/render-computer-permissions.mjs --check",
    "test:mysql": "node --test integration/mysql.integration.mjs",
    "eval:ai": "node scripts/eval-ai.mjs",
    "eval:templates": "node scripts/eval-templates.mjs",
    "google:doctor": "node scripts/google-doctor.mjs",
    "now": "node scripts/generate-now.mjs",
    "now:check": "node scripts/generate-now.mjs --check",
    "check:continuity": "node scripts/check-continuity.mjs",
    "check:secrets": "node scripts/check-secrets-wiring.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:edge": "node scripts/verify-live.mjs --mode edge --url https://celia-phone-google.celiaelazamey.workers.dev"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "googleapis": "^188.0.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.14.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1"
  }
}
